# Saída do teste de fumaça
saida-fumaca/

# Binários e conteúdo gerado do servidor portátil.
# O diretório web/ existe apenas para o `go:embed`; o conteúdo real é copiado
# de dist/ pelo scripts/build-portatil.sh.
portatil/
cmd/servidor/web/*
!cmd/servidor/web/.gitkeep
cmd/servidor/servidor
cmd/servidor/servidor.exe

# Dados e chave da API de autorização. A chave privada assina as credenciais
# de acesso: nunca pode ser versionada.
cmd/api/dados/
cmd/api/api
cmd/api/paineis.json
*.pem
